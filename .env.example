# Development-only PostgreSQL settings for the local Compose stack. Do not use production credentials.
POSTGRES_DB=repotriage
POSTGRES_USER=repotriage
POSTGRES_PASSWORD=change-me-for-local-development

# The browser-facing frontend origin permitted by the API.
CORS_ORIGIN=http://localhost:5173

# The browser uses this host-published API address.
VITE_API_BASE_URL=http://localhost:8000

# AI gateway (Milestone 2.2). Leave AI_PROVIDER unset/mock for a free,
# fully offline stack — this is the default for development, automated
# tests, and the normal demo. Set AI_PROVIDER=openai and provide a real
# OPENAI_API_KEY only when you intend to make real, billed OpenAI calls;
# the worker refuses to start if AI_PROVIDER=openai and no key is set.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_SECONDS=20
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.15
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=0.60

# Repository-grounded retrieval (Milestone 2.3). "local" (the default) uses
# a real, local, CPU-only embedding model baked into the backend image at
# build time — no paid API call and no network access at runtime. "fake"
# is a fast, deterministic hash-based embedder used only by the test suite.
EMBEDDING_PROVIDER=local
RETRIEVAL_MAX_RESULTS=3