# Development-only PostgreSQL settings for the local Compose stack. Do not use production credentials.
POSTGRES_DB=repotriage
POSTGRES_USER=repotriage
POSTGRES_PASSWORD=change-me-for-local-development

# The browser-facing frontend origin permitted by the API.
CORS_ORIGIN=http://localhost:5173

# The browser uses this host-published API address.
VITE_API_BASE_URL=http://localhost:8000